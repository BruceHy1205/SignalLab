# ---- 主平台 ----
DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal

# 可选:非空时 API 要求 Authorization: Bearer <token>
API_TOKEN=

SCHEDULER_ENABLED=false
SCHEDULER_CRON_HOUR=17
SCHEDULER_CRON_MINUTE=30
SCHEDULER_TIMEZONE=Asia/Shanghai

# ---- datahub ----
DATAHUB_TUSHARE_TOKEN=
DATAHUB_AKSHARE_REQUEST_INTERVAL_SEC=0.5

# ---- LLM(tracker 抽取 + agents);留空则规则模式 ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- agents ----
WATCHLIST=
AGENT_MAX_CANDIDATES=10
AGENT_MAX_LLM_COST_USD=2.0

# ---- research(M4/M5) ----
RUNNER_CALLBACK_SECRET=dev-secret
RESEARCH_CALLBACK_HOST=http://127.0.0.1:8000
RESEARCH_DEFAULT_MAX_LOOPS=3
RESEARCH_ARTIFACTS_DIR=/tmp/signal-artifacts
RESEARCH_HEARTBEAT_TIMEOUT_SEC=600
# 本地 Qlib 快照根目录(子目录名=data_snapshot),remote_ssh 时 rsync 下发;
# 用 `make dump-qlib` 或 POST /api/datahub/export-qlib 生成
RESEARCH_DATA_SNAPSHOTS_DIR=
RESEARCH_REMOTE_IMAGE=signal-rdagent:stub
# 双框架镜像(按 producer 路由)
RESEARCH_ALPHAAGENT_IMAGE=signal-alphaagent:stub
RESEARCH_RDAGENT_IMAGE=signal-rdagent:stub
# stub=冒烟;real=容器内调官方 CLI(需 real 镜像或本机已装)
RESEARCH_RUNNER_BACKEND=stub
RESEARCH_REMOTE_WORK_ROOT=/tmp/signal-jobs
RESEARCH_SSH_PORT=22
RESEARCH_REMOTE_REVERSE_TUNNEL=false
RESEARCH_CLEANUP_REMOTE_ON_COMPLETE=true
# ---- 通知(邮件 + 飞书) ----
NOTIFY_ENABLED=false
NOTIFY_CHANNELS=email,feishu
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true
FEISHU_WEBHOOK_URL=

# ---- 实盘(人工确认队列;默认 stub) ----
# 真 miniQMT 必须在 Windows 宿主机跑 API(见 docs/deploy-windows.md),容器内请保持 stub
LIVE_BROKER=stub
LIVE_MINIQMT_ACCOUNT=
LIVE_MINIQMT_PATH=
LIVE_MINIQMT_SESSION_ID=
