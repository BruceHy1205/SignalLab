# ---- signal 生产环境模板 ----
# 复制为仓库根目录 .env.prod 后填实值:
#   cp .env.prod.example .env.prod
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod up -d --build

# 镜像标签
SIGNAL_IMAGE_TAG=latest

# ---- 数据库 ----
POSTGRES_USER=signal
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=signal

# ---- Caddy 入口 ----
# 有域名: your.domain.com  (自动 HTTPS)
# 仅 IP/内网: :80
SIGNAL_SITE_ADDRESS=:80
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_ACME_EMAIL=
CADDY_BASIC_AUTH_USER=admin
# 生成: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# compose 的 --env-file 里 bcrypt 的 $ 写成 $$
# 下列哈希对应明文 changeme —— 上线前务必更换
CADDY_BASIC_AUTH_HASH=$$2b$$14$$amIEWN4Da.mgo7YdbWBVSupXHhUhu4GxmA2e9JaCOHJwVmNVGCo9G

# ---- API ----
# 可选;非空时要求 Authorization: Bearer <token>(Caddy Basic Auth 之外的第二层)
API_TOKEN=
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_CRON_HOUR=17
SCHEDULER_CRON_MINUTE=30
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
WATCHLIST=
RUNNER_CALLBACK_SECRET=replace-with-random-secret
# 容器内互调可用 http://api:8000;对外回调填公网 URL
RESEARCH_CALLBACK_HOST=http://api:8000
RESEARCH_DATA_SNAPSHOTS_DIR=/var/lib/signal/snapshots

# ---- 研究 / 通知 / 实盘 ----
RESEARCH_RUNNER_BACKEND=stub
NOTIFY_ENABLED=false
NOTIFY_CHANNELS=email,feishu
FEISHU_WEBHOOK_URL=
# 容器内请保持 stub;真 miniQMT 用 Windows host API(见 docs/deploy-windows.md)
LIVE_BROKER=stub
LIVE_MINIQMT_ACCOUNT=
# 例: D:\国金证券QMT交易端\userdata_mini
LIVE_MINIQMT_PATH=
LIVE_MINIQMT_SESSION_ID=

# ---- Windows Docker 可选端口 ----
# CADDY_HTTP_PORT=8080
# API_HOST_PORT=8000
# POSTGRES_HOST_PORT=5432
# HOST_API_PORT=8000

# ---- 备份(可选 profile) ----
# docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod --profile backup up -d
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_SEC=86400
BACKUP_S3_URI=
# S3/R2/MinIO 等
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
S3_ENDPOINT_URL=
